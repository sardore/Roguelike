function importOld() {
  const sheet = sheet_();
  const rows = sheet.getLastRow();
  if (rows > 1) {
    const times = sheet.getRange(2, 1, rows - 1, 1).getValues().map(v => String(v[0]));
    if (times.some(t => t && t < '2026-10-28')) return Logger.log('이미 옛 기록이 있어 넣지 않았다.');
  }
  const out = OLD_RECORDS.map((r, i) => [r[0], 'Legacy-' + String(i + 1).padStart(3, '0'), r[1], r[2], r[3], r[4], r[5]]);
  sheet.getRange(sheet.getLastRow() + 1, 1, out.length, 7).setValues(out);
  CacheService.getScriptCache().removeAll(['summary', 'ranking']);
  Logger.log(out.length + '건을 넣었다.');
}
